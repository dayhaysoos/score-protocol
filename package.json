{
  "name": "score-protocol",
  "version": "0.0.2-alpha",
  "private": false,
  "description": "SCORE Protocol Change and Slice preparation with reviewed, atomic Runner execution",
  "license": "MIT",
  "type": "module",
  "types": "dist/plan-intake-tool.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plan-intake-tool.d.ts",
      "import": "./dist/plan-intake-tool.js"
    },
    "./change": {
      "types": "./dist/change-authoring.d.ts",
      "import": "./dist/change-authoring.js"
    }
  },
  "bin": {
    "score": "dist/cli.js"
  },
  "files": [
    "dist",
    "migrations",
    "schema",
    "skills",
    "README.md",
    "CONTEXT.md"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:package": "npm run clean:dist && tsc -p tsconfig.build.json",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "npm run build:package",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "test:package": "node scripts/package-smoke.mjs",
    "experiment:declaration-contracts": "tsx src/prototypes/declaration-contract-experiment.ts",
    "experiment:agent-preflight": "tsx src/prototypes/agent-preflight-feedback.ts",
    "experiment:agent-preflight:mcp-smoke": "tsx src/prototypes/agent-preflight-mcp-smoke.ts",
    "experiment:final-candidate-check": "tsx --test test/open-code-final-candidate-check.test.ts test/agent-preflight-feedback-model.test.ts test/agent-preflight-mcp-server.test.ts",
    "experiment:automatic-repair": "tsx --test --test-name-pattern='continues one session|repair model turn|automatic repair continuation' test/open-code-adapter.test.ts",
    "experiment:approved-input-binding": "tsx --test --test-name-pattern='approved declaration repair binding|approved-revision binding' test/approved-declaration-binding.test.ts test/open-code-adapter.test.ts",
    "experiment:approved-multi-declaration": "tsx --test --test-name-pattern='binds two approved declarations|aggregates two approved declarations|repairs one failed declaration' test/approved-declaration-binding.test.ts test/agent-preflight-feedback-model.test.ts test/open-code-adapter.test.ts",
    "experiment:cross-file-route-retry": "tsx --test test/cross-file-declaration-route-retry.test.ts",
    "reproduce": "tsx src/cli.ts reproduce",
    "inspect": "tsx src/cli.ts inspect",
    "approve": "tsx src/cli.ts approve",
    "export": "tsx src/cli.ts export",
    "runner": "tsx src/runner/cli.ts"
  },
  "dependencies": {
    "@effect/sql-sqlite-node": "4.0.0-beta.104",
    "@inquirer/prompts": "8.5.2",
    "@opencode-ai/cli": "0.0.0-next-17111",
    "ajv": "8.20.0",
    "better-sqlite3": "13.0.3",
    "canonicalize": "3.0.0",
    "cli-table3": "0.6.5",
    "effect": "4.0.0-beta.104",
    "json-dup-key-validator": "1.0.3",
    "log-update": "8.0.0",
    "oxc-parser": "0.144.0",
    "string-width": "8.2.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.1.2",
    "tsx": "4.23.8",
    "typescript": "7.0.2"
  }
}
